# Environment variables required by functions/api/quote.js
#
# Do NOT put real values in this file or commit it with real values.
# Set these in the Cloudflare Pages dashboard instead:
# Pages project → Settings → Environment variables (add to both
# "Production" and "Preview" environments).

# Your Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Must be an address on a domain you've verified in Resend
# (https://resend.com/domains) -- Resend will reject unverified/free-mail
# "from" addresses such as a plain gmail.com address.
RESEND_FROM="Paving Unlimited <quotes@pavingunlimited.co.za>"

# Where completed quote requests should be delivered. Can be a
# comma-separated list, e.g. "pavingunlimited@gmail.com,cathryn@example.com"
RESEND_TO=pavingunlimited@gmail.com
